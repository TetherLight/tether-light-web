# このファイルをコピーして .env を作成し、実際の値を入力してください。
#   cp .env.example .env
# .env は .gitignore で除外されているため、コミットされません。

# microCMSの管理画面「サービス設定」>「APIキー」から取得
MICROCMS_API_KEY=

# サービスID（microCMSの管理画面URL https://xxxxx.microcms.io の xxxxx 部分）
MICROCMS_SERVICE_DOMAIN=

# 任意。OGP・構造化データの絶対URL生成に使用（未設定時はプレースホルダーURLになります）
# 例: https://tetherlight.github.io/tether-light-web
SITE_URL=
